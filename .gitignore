__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Data (tracked by DVC, not git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models (only the final shipped checkpoint is committed; experiment
# checkpoints stay local/MLflow-tracked instead of bloating git history)
models/*.pt
!models/model.pt
!models/.gitkeep

# MLflow
mlruns/
mlartifacts/

# DVC
.dvc/cache
.dvc/tmp

# Kaggle credentials - NEVER commit
kaggle.json

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
logs/
